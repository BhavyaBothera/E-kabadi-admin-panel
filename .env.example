# =========================================================
# E-KABAADI PLATFORM — Environment Variables
# =========================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# For static HTML serving, copy values to:
#   frontend/config/config.local.js
# See docs/environment-setup.md for details.
# =========================================================

# Supabase Project Configuration
# Get these from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJI...your-anon-key-here

# Data Mode: "mock" or "supabase"
# Default is "mock" — uses localStorage, no external dependencies
# Set to "supabase" when Supabase project is configured
DATA_MODE=mock

# ─── Server-Side Only Credentials (NEVER expose to frontend) ───
# SUPABASE_SERVICE_ROLE_KEY=    (server-side admin tasks only)
# GEMINI_API_KEY=               (server-side only: Supabase Edge Function 'analyze-scrap')
#                               Set in Supabase via: supabase secrets set GEMINI_API_KEY=AIzaSy...

# ─── Phase 4E: Map & Geocoding Configuration ───
# MAP_PROVIDER: "mock" (default offline SVG radar) | "leaflet" (OpenStreetMap) | "mapbox" | "google"
MAP_PROVIDER=mock
# Public client-safe map key if using Mapbox or Google (MUST be HTTP-referrer restricted)
MAP_PUBLIC_KEY=
MAP_STYLE=

# GEOCODING_PROVIDER: "mock" (default local lookup) | "nominatim" | "google"
GEOCODING_PROVIDER=mock

# ─── Future Phase Placeholders ───
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=          (server-side only)
# SMS_OTP_PROVIDER_KEY=         (server-side only)
