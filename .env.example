# =========================================================
# E-KABAADI PLATFORM — Environment Variables
# =========================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# For static HTML serving, copy values to:
#   frontend/config/config.local.js
# See docs/environment-setup.md for details.
# =========================================================

# Supabase Project Configuration
# Get these from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJI...your-anon-key-here

# Data Mode: "mock" or "supabase"
# Default is "mock" — uses localStorage, no external dependencies
# Set to "supabase" when Supabase project is configured
DATA_MODE=mock

# ─── Server-Side Only Credentials (NEVER expose to frontend) ───
# SUPABASE_SERVICE_ROLE_KEY=    (server-side admin tasks only)
# GEMINI_API_KEY=               (server-side only: Supabase Edge Function 'analyze-scrap')
#                               Set in Supabase via: supabase secrets set GEMINI_API_KEY=AIzaSy...

# ─── Phase 4E: Map & Geocoding Configuration ───
# MAP_PROVIDER: "mock" (default offline SVG radar) | "leaflet" (OpenStreetMap) | "mapbox" | "google"
MAP_PROVIDER=mock
# Public client-safe map key if using Mapbox or Google (MUST be HTTP-referrer restricted)
MAP_PUBLIC_KEY=
MAP_STYLE=

# GEOCODING_PROVIDER: "mock" (default local lookup) | "nominatim" | "google"
GEOCODING_PROVIDER=mock

# ─── Phase 4F: Payment Provider & Real Gateway Configuration ───
# PAYMENT_PROVIDER: "mock" (default offline deterministic engine) | "razorpay" (Supabase Edge Functions)
PAYMENT_PROVIDER=mock

# PUBLIC Client-Side Key (Required by Razorpay Checkout modal in browser)
RAZORPAY_KEY_ID=

# ─── Server-Side Only Secrets (Edge Functions — NEVER expose to frontend or Git) ───
# RAZORPAY_KEY_SECRET=          (Supabase Edge Function secret: create-payment-order, verify-payment)
#                               Set via: supabase secrets set RAZORPAY_KEY_SECRET=your_secret_here
# RAZORPAY_WEBHOOK_SECRET=      (Supabase Edge Function secret: razorpay-webhook)
#                               Set via: supabase secrets set RAZORPAY_WEBHOOK_SECRET=your_wh_secret_here

# ─── Phase 4G: Real-Time Notification & Communication System ───
# Providers: "mock" (default offline deterministic engines) | "resend" | "sendgrid" | "twilio" | "fcm"
NOTIFICATION_EMAIL_PROVIDER=mock
NOTIFICATION_SMS_PROVIDER=mock
NOTIFICATION_PUSH_PROVIDER=mock

# ─── Server-Side Only Secrets (Edge Functions — NEVER expose to frontend or Git) ───
# EMAIL_API_KEY=                (server-side only: Resend / SendGrid / SES)
# SMS_API_KEY=                  (server-side only: Twilio / MSG91)
# PUSH_API_KEY=                 (server-side only: Firebase Cloud Messaging / Web Push)

